---
import '../styles/global.css';
import CourseMap from '../components/CourseMap.vue';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Foundations of Machine Learning</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
	</head>
	<body>
		<div class="page-bg" aria-hidden="true">
			<div class="blob blob-1" data-speed="0.4"></div>
			<div class="blob blob-2" data-speed="-0.6"></div>
			<div class="blob blob-3" data-speed="0.9"></div>
		</div>
		<CourseMap client:load />

		<script>
			// ponytail: direct scroll->transform, no lerp/smoothing library needed for a subtle parallax
			const blobs = Array.from(document.querySelectorAll<HTMLElement>('.blob'));
			let ticking = false;

			function updateBlobs() {
				const y = window.scrollY;
				for (const blob of blobs) {
					const speed = Number(blob.dataset.speed);
					blob.style.transform = `translate3d(0, ${y * speed}px, 0)`;
				}
				ticking = false;
			}

			window.addEventListener(
				'scroll',
				() => {
					if (!ticking) {
						requestAnimationFrame(updateBlobs);
						ticking = true;
					}
				},
				{ passive: true },
			);
		</script>
	</body>
</html>

<style is:global>
	body {
		margin: 0;
		background: #0a0d13;
		color: #f4f3ef;
		font-family: 'Inter', sans-serif;
		position: relative;
	}
	a { color: #6d5ef8; }
	a:hover { color: #c8ff4d; }

	/* Background inspired by the Slidev deck's blurred glow shapes */
	.page-bg {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		pointer-events: none;
		filter: blur(70px);
	}
	.blob {
		position: absolute;
		border-radius: 50%;
		opacity: 0.35;
		transition: transform 0.2s linear;
		will-change: transform;
	}
	.blob-1 {
		top: -10%;
		left: -8%;
		width: 46vw;
		height: 46vw;
		background: linear-gradient(135deg, #18549a, #12238b);
	}
	.blob-2 {
		bottom: -15%;
		right: -10%;
		width: 50vw;
		height: 50vw;
		background: linear-gradient(315deg, #18549a, #12238b);
	}
	.blob-3 {
		top: 40%;
		left: 55%;
		width: 26vw;
		height: 26vw;
		background: linear-gradient(to top, #01b6d1, #aaf7ff);
		opacity: 0.18;
	}
</style>
